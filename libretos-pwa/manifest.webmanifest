{
  "name": "Libretos",
  "short_name": "Libretos",
  "description": "Lector de libretos para narrar videoclases, con seguimiento por voz.",
  "lang": "es-CO",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0B1320",
  "theme_color": "#05080D",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "libreto", "accept": ["text/markdown", "text/x-markdown", "text/plain", "application/octet-stream", ".md", ".markdown", ".txt"] }
      ]
    }
  }
}
